# Copia questo file come ".env" e inserisci la tua chiave da https://developer.riotgames.com
# Le Development Key scadono ogni 24 ore: per l'aggiornamento automatico serve una Personal API Key.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Usati dalla dashboard (lol_dashboard.py / refresh_dashboard.bat)
# Uno o piu' account separati da ; (ognuno avra' la sua dashboard)
RIOT_IDS=Nome#TAG; Altro Nome#EUW
RIOT_REGION=europe
